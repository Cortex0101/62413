<Window x:Class="RatMan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="clr-namespace:RatMan.Game;assembly=RatMan.Game"
        xmlns:viewModels="clr-namespace:RatMan.App.ViewModels"
        Title="RatMan"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="500"
        Background="#161821"
        Foreground="#F4EBD0"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Up" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="W" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="Down" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="S" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="Left" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="A" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="Right" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
        <KeyBinding Key="D" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
    </Window.InputBindings>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Center"
                   FontSize="34"
                   FontWeight="Bold"
                   Text="RatMan" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,20"
                   HorizontalAlignment="Center"
                   Foreground="#C8C8D0"
                   Text="Move with the arrow keys or W, A, S, D" />

        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#A8C686"
                BorderThickness="3"
                Background="#242735">
            <Canvas Width="{Binding BoardWidth}"
                    Height="{Binding BoardHeight}"
                    ClipToBounds="True">
                <ItemsControl Width="{Binding BoardWidth}"
                              Height="{Binding BoardHeight}"
                              ItemsSource="{Binding BoardCells}"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="36"
                                       Height="36"
                                       Fill="Transparent"
                                       Stroke="#3B4052"
                                       StrokeThickness="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Canvas.Left="{Binding PlayerLeft}"
                           Canvas.Top="{Binding PlayerTop}"
                           Width="26"
                           Height="26"
                           Margin="5"
                           RadiusX="4"
                           RadiusY="4"
                           Fill="#F2C14E"
                           Stroke="#FFF4CF"
                           StrokeThickness="2" />
            </Canvas>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding PlayerPosition, StringFormat=Current position: {0}}" />
    </Grid>
</Window>
