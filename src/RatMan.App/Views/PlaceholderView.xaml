<UserControl x:Class="RatMan.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Style="{StaticResource ScreenTitleStyle}"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,16,0,28"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding Message}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Width="180"
                    HorizontalAlignment="Center"
                    Command="{Binding ReturnToMenuCommand}"
                    Content="Return to Menu" />
        </StackPanel>
    </Grid>
</UserControl>
