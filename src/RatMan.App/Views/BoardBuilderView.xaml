<UserControl x:Class="RatMan.App.Views.BoardBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatMan.App.ViewModels"
             Focusable="True" Loaded="OnLoaded" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="CanvasPanel"><Canvas /></ItemsPanelTemplate>
        <Style x:Key="PositionedItem" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <DataTemplate x:Key="WallTemplate">
            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{DynamicResource WallBrush}" />
        </DataTemplate>
        <Style x:Key="SpawnMarker" TargetType="Border">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
        <Viewbox Margin="0,0,20,0" HorizontalAlignment="Left" Stretch="Uniform">
            <Border Style="{StaticResource BoardFrameStyle}" BorderThickness="0">
                <Canvas x:Name="BoardCanvas" Width="{Binding BoardWidth}" Height="{Binding BoardHeight}"
                        Background="Transparent" ClipToBounds="True" MouseDown="OnBoardClick"
                        MouseMove="OnBoardMove" MouseLeave="OnBoardLeave">
                    <ItemsControl ItemsSource="{Binding BoardCells}" IsHitTestVisible="False"
                                  ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource PositionedItem}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="36" Height="36">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource GridLineBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WallBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource WallBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding RenderedWalls}" IsHitTestVisible="False"
                                  ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource PositionedItem}"
                                  ItemTemplate="{StaticResource WallTemplate}" />
                    <Border Style="{StaticResource SpawnMarker}" Background="{DynamicResource PlayerBrush}"
                            Canvas.Left="{Binding PlayerLeft}" Canvas.Top="{Binding PlayerTop}"
                            Visibility="{Binding HasPlayerSpawn, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="P" Foreground="#161821" FontWeight="Bold" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource SpawnMarker}" Background="#BE5B77"
                            Canvas.Left="{Binding MonsterLeft}" Canvas.Top="{Binding MonsterTop}"
                            Visibility="{Binding HasMonsterSpawn, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="M" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding PreviewSegments}" IsHitTestVisible="False" Opacity="0.5"
                                  ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource PositionedItem}"
                                  ItemTemplate="{StaticResource WallTemplate}" />
                    <Border Style="{StaticResource SpawnMarker}" Background="{DynamicResource AccentBrush}" Opacity="0.5"
                            Canvas.Left="{Binding PreviewLeft}" Canvas.Top="{Binding PreviewTop}"
                            Visibility="{Binding HasPreviewCell, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding PreviewLabel}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Canvas>
            </Border>
        </Viewbox>
        <Border Grid.Column="1" Padding="16" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Board Builder" FontSize="26" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="Board name" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BoardName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Board name" />
                    <Grid Margin="0,12,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Width" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WidthInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"
                                     LostKeyboardFocus="OnDimensionLostFocus" KeyDown="OnDimensionKeyDown" AutomationProperties.Name="Width" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Height" Margin="0,0,0,4" />
                            <TextBox Text="{Binding HeightInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"
                                     LostKeyboardFocus="OnDimensionLostFocus" KeyDown="OnDimensionKeyDown" AutomationProperties.Name="Height" />
                        </StackPanel>
                    </Grid>
                    <Button Content="1 · Wall" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:BuilderTool.Wall}" Margin="0,3" />
                    <Button Content="2 · Player spawn" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:BuilderTool.Player}" Margin="0,3" />
                    <Button Content="3 · Monster spawn" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:BuilderTool.Monster}" Margin="0,3" />
                    <Button Content="Rotate wall (R)" Command="{Binding RotateCommand}" Margin="0,3" />
                    <TextBlock Text="{Binding ToolDescription}" TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Left-click to place. Right-click to remove. Border openings are paired and wrap to the opposite side. Unreachable cells fill after placing P. P = player, M = monster. Dimensions: 1–100."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,3" />
                    <Button Content="Load Board" Command="{Binding LoadBoardCommand}" Margin="0,3" />
                    <Button Content="New Board" Command="{Binding NewBoardCommand}" Margin="0,3" />
                    <Button Content="Return to Menu" Command="{Binding ReturnToMenuCommand}" Margin="0,12,0,3" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
