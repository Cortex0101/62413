<Window x:Class="RatMan.App.Views.HighScoreEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New high score" Width="480" SizeToContent="Height" MaxHeight="700"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding SkipCommand}" />
    </Window.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="New high score!" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding MapName}" TextWrapping="Wrap" FontSize="18" Margin="0,12,0,6" />
            <TextBlock Text="{Binding ResultText}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24" />
            <Label Content="_Name (optional)" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource PrimaryTextBrush}" Padding="0,0,0,8" />
            <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                     IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Name (optional)" />
            <TextBlock Text="Leave blank to save as Anonymous. Up to 24 characters." TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Content="_Skip" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="_Save Score" Command="{Binding SaveCommand}" IsDefault="True" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
