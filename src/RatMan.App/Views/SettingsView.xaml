<UserControl x:Class="RatMan.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ReturnToMenuCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="32">
        <StackPanel Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource ScreenTitleStyle}" Text="{Binding Title}" />
            <TextBlock x:Name="BindingHint" Margin="0,12,0,20" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.Resources>
                    <DataTemplate x:Key="KeyLabelTemplate">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ItemsControl.Resources>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding Binding.Description}" />
                            <Button Grid.Column="1" Margin="4,0" Padding="6,9"
                                    Tag="{Binding Binding.FirstKey}" ToolTip="{Binding Binding.FirstKeyLabel}"
                                    Content="{Binding Binding.FirstKeyLabel}" ContentTemplate="{StaticResource KeyLabelTemplate}"
                                    AutomationProperties.HelpText="{Binding Binding.Description, StringFormat='{}{0}, first binding'}"
                                    Click="OnBindingClick" LostKeyboardFocus="OnBindingLostFocus" />
                            <Button Grid.Column="2" Margin="4,0,0,0" Padding="6,9"
                                    Tag="{Binding Binding.SecondKey}" ToolTip="{Binding Binding.SecondKeyLabel}"
                                    Content="{Binding Binding.SecondKeyLabel}" ContentTemplate="{StaticResource KeyLabelTemplate}"
                                    AutomationProperties.HelpText="{Binding Binding.Description, StringFormat='{}{0}, second binding'}"
                                    Click="OnBindingClick" LostKeyboardFocus="OnBindingLostFocus" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Margin="0,20,0,0" HorizontalAlignment="Center"
                    Command="{Binding ReturnToMenuCommand}" Content="Return to Menu" />
        </StackPanel>
    </Grid>
</UserControl>
