<UserControl x:Class="RatMan.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="clr-namespace:RatMan.Game;assembly=RatMan.Game"
             Focusable="True"
             Loaded="OnLoaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Up" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="W" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="Down" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="S" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="Left" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="A" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="Right" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
        <KeyBinding Key="D" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
        <KeyBinding Key="Escape" Command="{Binding ReturnToMenuCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Padding="16,7"
                    HorizontalAlignment="Left"
                    Command="{Binding ReturnToMenuCommand}"
                    Content="Return to Menu" />
            <TextBlock Style="{StaticResource ScreenTitleStyle}"
                       Text="{Binding Title}" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,20"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Move with the arrow keys or W, A, S, D" />

        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BoardFrameStyle}">
            <Canvas Width="{Binding BoardWidth}"
                    Height="{Binding BoardHeight}"
                    ClipToBounds="True">
                <ItemsControl Width="{Binding BoardWidth}"
                              Height="{Binding BoardHeight}"
                              ItemsSource="{Binding BoardCells}"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{DynamicResource GameCellSize}"
                                       Height="{DynamicResource GameCellSize}"
                                       Fill="Transparent"
                                       Stroke="{DynamicResource GridLineBrush}"
                                       StrokeThickness="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Width="{Binding BoardWidth}"
                              Height="{Binding BoardHeight}"
                              ItemsSource="{Binding WallSegments}"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Width}"
                                       Height="{Binding Height}"
                                       Fill="{DynamicResource WallBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Canvas.Left="{Binding PlayerLeft}"
                           Canvas.Top="{Binding PlayerTop}"
                           Width="26"
                           Height="26"
                           Margin="5"
                           RadiusX="4"
                           RadiusY="4"
                           Fill="{DynamicResource PlayerBrush}"
                           Stroke="{DynamicResource PlayerOutlineBrush}"
                           StrokeThickness="2" />
            </Canvas>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding PlayerPosition, StringFormat=Current position: {0}}" />
    </Grid>
</UserControl>
