<UserControl x:Class="RatMan.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="clr-namespace:RatMan.Game;assembly=RatMan.Game"
             Focusable="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Up" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="W" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Up}" />
        <KeyBinding Key="Down" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="S" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Down}" />
        <KeyBinding Key="Left" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="A" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Left}" />
        <KeyBinding Key="Right" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
        <KeyBinding Key="D" Command="{Binding MoveCommand}" CommandParameter="{x:Static game:Direction.Right}" />
        <KeyBinding Key="Escape" Command="{Binding ReturnToMenuCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0"
                 Margin="0,0,20,0"
                 HorizontalAlignment="Left"
                 Stretch="Uniform">
            <Border Style="{StaticResource BoardFrameStyle}" BorderThickness="0">
                <Canvas Width="{Binding BoardWidth}"
                        Height="{Binding BoardHeight}"
                        ClipToBounds="True">
                    <ItemsControl Width="{Binding BoardWidth}"
                                  Height="{Binding BoardHeight}"
                                  ItemsSource="{Binding BoardCells}"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="36" Height="36">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource GridLineBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WallBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource WallBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Width="{Binding BoardWidth}"
                                  Height="{Binding BoardHeight}"
                                  ItemsSource="{Binding RenderedWalls}"
                                  IsHitTestVisible="False" Panel.ZIndex="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="{Binding Width}"
                                           Height="{Binding Height}"
                                           Fill="{DynamicResource WallBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Food.Items}" Style="{StaticResource FoodLayerStyle}" Panel.ZIndex="1" />
                    <ItemsControl ItemsSource="{Binding Cats}" Width="{Binding BoardWidth}" Height="{Binding BoardHeight}"
                                  Panel.ZIndex="9" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Width="{DynamicResource GameCellSize}" Height="{DynamicResource GameCellSize}"
                                       Source="{Binding CurrentImage}" Opacity="{Binding Opacity}"
                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolVisibility}}"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Image Canvas.Left="{Binding PlayerLeft}"
                           Canvas.Top="{Binding PlayerTop}"
                           Panel.ZIndex="10"
                           Width="{DynamicResource GameCellSize}"
                           Height="{DynamicResource GameCellSize}"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"
                           Source="{Binding PlayerImage}"
                           Stretch="Uniform" />
                </Canvas>
            </Border>
        </Viewbox>

        <Border Grid.Column="1"
                Padding="20"
                Background="{DynamicResource PanelBackgroundBrush}"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Margin="0,0,0,20"
                               HorizontalAlignment="Left"
                               Style="{StaticResource ScreenTitleStyle}"
                               FontSize="26" TextWrapping="Wrap"
                               Text="{Binding Title}" />
                    <TextBlock Text="Score" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Score}" FontSize="36" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Score" />
                    <TextBlock Text="{Binding Lives, StringFormat='Lives: {0}'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CheeseText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PowerText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Cheese: 1 · Steroid: 5 · Cat: 20" TextWrapping="Wrap" Margin="0,0,0,16"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding Cats}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Image DockPanel.Dock="Left" Source="{Binding Portrait}" Width="32" Height="32" Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Padding="12,9"
                            Command="{Binding ReturnToMenuCommand}"
                            Content="Return to Menu" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Margin="0,0,0,8"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Controls" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Move with the arrow keys or W, A, S, D." />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Press Esc to return to the menu." />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,28,0,0">
                    <TextBlock Text="{Binding MapWarnings}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Margin="0,0,0,8"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Current position" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding PlayerPosition}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>
        <Border Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#D9101522" CornerRadius="8"
                Visibility="{Binding HasOverlay, Converter={StaticResource BoolVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                <TextBlock Text="{Binding OutcomeTitle}" FontSize="38" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding OutcomeMessage}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,24" />
                <TextBlock Text="{Binding HighScoreStatus}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry High Score" Command="{Binding RetryHighScoreCommand}" Margin="0,0,0,10"
                        Visibility="{Binding HasHighScoreError, Converter={StaticResource BoolVisibility}}" />
                <Button Content="Replay" Command="{Binding ReplayCommand}" Focusable="False" Padding="20,12" Margin="0,0,0,10"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolVisibility}}" />
                <Button Content="High Scores" Command="{Binding ShowHighScoresCommand}" Padding="20,12" Margin="0,0,0,10"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolVisibility}}" />
                <Button Content="Return to Menu" Command="{Binding ReturnToMenuCommand}" Padding="20,12" Focusable="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
