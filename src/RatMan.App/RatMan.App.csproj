<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<RootNamespace>RatMan.App</RootNamespace>
	<AssemblyName>RatMan</AssemblyName>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\RatMan.Game\RatMan.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="..\RatMan.Game\assets\img\ratman-spritesheet.png"
			  Link="Assets\Images\ratman-spritesheet.png" />
  </ItemGroup>

</Project>
