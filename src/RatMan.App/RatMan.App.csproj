<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<RootNamespace>RatMan.App</RootNamespace>
	<AssemblyName>RatMan</AssemblyName>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
	<EmbeddedResource Include="Resources\Classic.maze" LogicalName="RatMan.App.Classic.maze" />
	<ProjectReference Include="..\RatMan.Game\RatMan.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="..\RatMan.Game\assets\img\ratman-spritesheet.png"
			  Link="Assets\Images\ratman-spritesheet.png" />
    <Resource Include="..\RatMan.Game\assets\img\tiny-cheese.png" Link="Assets\Images\tiny-cheese.png" />
    <Resource Include="..\RatMan.Game\assets\img\huge-cheese.png" Link="Assets\Images\huge-cheese.png" />
	  <Resource Include="..\RatMan.Game\assets\img\ratman-steroid-spritesheet.png" Link="Assets\Images\ratman-steroid-spritesheet.png" />
  </ItemGroup>

</Project>
