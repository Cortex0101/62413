<Application x:Class="RatMan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:RatMan.App.ViewModels"
             xmlns:views="clr-namespace:RatMan.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate DataType="{x:Type viewModels:MainMenuViewModel}">
            <views:MainMenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GameViewModel}">
            <views:GameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BoardBuilderViewModel}">
            <views:BoardBuilderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MapSelectionViewModel}">
            <views:MapSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
