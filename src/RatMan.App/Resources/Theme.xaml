<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="WindowBackgroundColor">#161821</Color>
    <Color x:Key="PanelBackgroundColor">#242735</Color>
    <Color x:Key="PrimaryTextColor">#F4EBD0</Color>
    <Color x:Key="SecondaryTextColor">#C8C8D0</Color>
    <Color x:Key="AccentColor">#A8C686</Color>
    <Color x:Key="GridLineColor">#3B4052</Color>
    <Color x:Key="WallColor">#A8C686</Color>
    <Color x:Key="PlayerColor">#F2C14E</Color>
    <Color x:Key="PlayerOutlineColor">#FFF4CF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
    <SolidColorBrush x:Key="WallBrush" Color="{StaticResource WallColor}" />
    <SolidColorBrush x:Key="PlayerBrush" Color="{StaticResource PlayerColor}" />
    <SolidColorBrush x:Key="PlayerOutlineBrush" Color="{StaticResource PlayerOutlineColor}" />

    <sys:Double x:Key="TitleFontSize">34</sys:Double>
    <sys:Double x:Key="GameCellSize">36</sys:Double>
</ResourceDictionary>
